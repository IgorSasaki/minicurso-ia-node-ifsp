{
  "name": "rota-tech",
  "version": "1.0.0",
  "private": true,
  "description": "Rota Tech — mentor de carreira com IA. Projeto do minicurso 'Desenvolvimento de Aplicações Inteligentes com Node.js e IA Generativa' (Semana da Informática IFSP Araraquara).",
  "author": "Igor Leonardo Sasaki da Silva Moreira (https://www.linkedin.com/in/igor-sasaki/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorSasaki/minicurso-ia-node-ifsp.git"
  },
  "homepage": "https://github.com/IgorSasaki/minicurso-ia-node-ifsp#readme",
  "keywords": [
    "nodejs",
    "typescript",
    "gemini",
    "ia-generativa",
    "llm",
    "rag",
    "embeddings",
    "fastify",
    "zod",
    "minicurso",
    "ifsp"
  ],
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hello": "tsx --env-file-if-exists=.env scripts/01-hello.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "similarity": "tsx --env-file-if-exists=.env scripts/04-similarity.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@google/genai": "^2.30.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}

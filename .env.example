# ============================================================
# Rota Tech — configuração da IA (Google Gemini)
# Copie este arquivo para .env:   cp .env.example .env
# NUNCA faça commit do .env (ele já está no .gitignore).
# ============================================================

# Crie sua chave gratuita em https://aistudio.google.com/apikey
# (não precisa de cartão de crédito)
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo de geração de texto. Flash-Lite = rápido e com cota gratuita generosa.
GEMINI_MODEL=gemini-3.5-flash-lite

# Quanto o modelo "pensa" antes de responder: MINIMAL | LOW | MEDIUM | HIGH
# Mais pensamento = respostas mais elaboradas, porém mais lentas.
# (deixe vazio para usar o padrão do modelo)
GEMINI_THINKING_LEVEL=MINIMAL

# Modelo de embeddings (usado no RAG, a partir da etapa 4)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Tempo máximo (ms) esperando a resposta da IA antes de desistir
LLM_TIMEOUT_MS=30000

# Porta da API
PORT=3333
